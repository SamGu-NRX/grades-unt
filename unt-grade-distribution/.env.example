DATABASE_URL="postgresql://postgres.[project-ref]:[password]@aws-0-[region].pooler.supabase.com:6543/postgres?pgbouncer=true"
DIRECT_URL="postgresql://postgres:[password]@db.[project-ref].supabase.co:5432/postgres"

# /api/mcp browser CORS only. Defaults to * for public, read-only tools without credentials.
# Comma-separated exact origins, e.g. https://planner.example,http://localhost:3000.
# Set an empty value to disable browser CORS. Extension origin checks are unchanged.
MCP_CORS_ORIGINS="*"

# Production request protection (server-only; required before deployment).
# Use an existing authorized Redis REST endpoint with EVAL support.
# RATE_LIMIT_REDIS_REST_URL="https://your-redis-rest-endpoint"
# RATE_LIMIT_REDIS_REST_TOKEN="set-in-hosting-secrets"
# RATE_LIMIT_NAMESPACE="unt-grades"
# Optional quotas and self-hosted trusted-proxy setup: see RATE_LIMITS.md.
