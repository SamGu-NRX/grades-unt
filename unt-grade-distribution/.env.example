DATABASE_URL="postgresql://postgres.[project-ref]:[password]@aws-0-[region].pooler.supabase.com:6543/postgres?pgbouncer=true"
DIRECT_URL="postgresql://postgres:[password]@db.[project-ref].supabase.co:5432/postgres"

# /api/mcp browser CORS only. Defaults to https://untangleapp.vercel.app when unset.
# Comma-separated exact origins, e.g. https://untangleapp.vercel.app,http://localhost:3000.
# "*" allows any site; an empty value disables browser CORS. Extension origin checks are unchanged.
# MCP_CORS_ORIGINS="https://untangleapp.vercel.app"

# Production request protection (server-only; required before deployment).
# Use an existing authorized Redis REST endpoint with EVAL support.
# RATE_LIMIT_REDIS_REST_URL="https://your-redis-rest-endpoint"
# RATE_LIMIT_REDIS_REST_TOKEN="set-in-hosting-secrets"
# RATE_LIMIT_NAMESPACE="unt-grades"
# Optional quotas and self-hosted trusted-proxy setup: see RATE_LIMITS.md.
